NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# OAuth buttons (Google, GitHub) appear automatically for providers enabled in
# Supabase → Authentication → Sign In / Providers — no env var needed.

# used for absolute URLs (OG images); defaults to http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Web Push public key (from the send-reminders "setup" action)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
