NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# optional: show OAuth buttons (enable the providers in Supabase first)
# NEXT_PUBLIC_AUTH_PROVIDERS=github,google
# used for absolute URLs (OG images); defaults to http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Web Push public key (from the send-reminders "setup" action)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
